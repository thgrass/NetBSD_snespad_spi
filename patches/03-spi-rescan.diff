+/*
+ * Rescan for children, e.g. when a driver module with "at spi?"
+ * cfdata is loaded at runtime (config_cfdata_attach -> rescan_with_cfdata)
+ * or via "drvctl -r -a spi <bus>".
+ */
+static int
+spi_rescan(device_t self, const char *ifattr, const int *ldesc)
+{
+
+	KASSERT(ifattr && !strcmp(ifattr, "spi"));
+
+	config_search(self, NULL,
+	    CFARGS(.search = spi_search));
+	return 0;
+}
