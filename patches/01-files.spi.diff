--- a/sys/dev/spi/files.spi
+++ b/sys/dev/spi/files.spi
@@ -51,3 +51,11 @@
 # Bosch BMP280 / BME280 sensor
 attach  bmx280thp at spi with bmx280thpspi
 file	dev/spi/bmx280thpspi.c		bmx280thpspi
+
+# SNES gamepads via the SNES-Gamepads-to-SPI-Adaptor board.
+# Each pad's latch is wired to a chip select and its data line is gated
+# onto MISO, so the pads are plain SPI mode-0 slaves: "snespad* at spi?
+# slave N" (slave N = chip select N).
+device	snespad: wskbddev
+attach	snespad at spi
+file	dev/spi/snespad.c		snespad
